VERDICTS = ("PASS", "FAIL", "TIMEOUT", "LEAK", "SIGKILL")
# Worst-first, for the rare filter that selects more than one test: the run's
# one verdict is the worst any matched test carried.
SEVERITY = {"SIGKILL": 5, "TIMEOUT": 4, "FAIL": 3, "LEAK": 2, "PASS": 1}

ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")
# `    PASS [   0.012s] (  1/111) fleet-core::policy the_test_name` — nextest
# right-aligns the running index to the total's width, so the parenthesised
# group must tolerate leading spaces on either number. TERMINATING lines
# (`(───────)` instead of `(n/n)`) still never match; they are not a final verdict.
TOKEN_RE = re.compile(
    r"^\s*(PASS|FAIL|TIMEOUT|LEAK|SIGKILL)\s+\[\s*[\d.]+s\]\s+\(\s*\d+/\d+\)\s+(\S+)\s+(.+?)\s*$"
)
# `     Summary [   0.016s] 1 test run: 0 passed, 1 failed, 924 skipped`
SUMMARY_RE = re.compile(r"Summary\s+\[\s*[\d.]+s\]\s+(\d+)\s+tests?\s+run:\s*(.*?)\s*$")

