#!/usr/bin/env python3
"""lessons-check — the one reader of fleet/brain/lessons/.

The lessons files carry two contracts nothing else enforces. Each `###` entry
owes five labelled fields, because a fact without the release and date it was
measured on is a rumour by the files' own preamble. And each file's
`## Test inventory` table is what the controller slices read to name their
fixture tests, so a table that drops a row, duplicates one, disagrees with the
entry that names the slug, or vanishes entirely breaks a contract the slices
depend on with nothing to say so.

The third check is the boundary: no lessons document may name a roster seat's
chosen name or a seat directory, so the documents read as this fleet's own
knowledge.

Exit 0 when every check passes, 1 when any fails, 2 when the check could not
be run at all.
"""

import re
import subprocess
import sys
from pathlib import Path

FIELDS = ("Fact", "Version", "Date", "Implies", "Test")

ENTRY_RE = re.compile(r"^### ([A-Za-z]+\d+)\.")
HEADING_RE = re.compile(r"^#{1,3} ")
FIELD_RE = re.compile(r"^- \*\*([A-Za-z]+):\*\*")
SLUG_RE = re.compile(r"lessons::([a-z0-9_]+)")
ROW_RE = re.compile(r"^\|\s*`lessons::([a-z0-9_]+)`\s*\|\s*(\S+)")

failures = []


def fail(where, message):
    failures.append(f"lessons-check: {where}: {message}")


def repo_root():
    out = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
    )
    if out.returncode != 0:
        sys.exit("lessons-check: not inside a git checkout — nothing to read")
    return Path(out.stdout.strip())


def tracked(root, prefix):
    """The tracked files under prefix. git, not a walk: a build writes a
    target/ directory the ignore file covers and a walk would read."""
    out = subprocess.run(
        ["git", "-C", str(root), "ls-files", "--", prefix],
        capture_output=True,
        text=True,
    )
    if out.returncode != 0:
        sys.exit(f"lessons-check: git ls-files {prefix} failed")
    return [p for p in out.stdout.splitlines() if p]


def parse_entries(lines):
    """(entry id, {field: value}) per `###` entry, in file order. A field's
    value is its own line plus every continuation line under it."""
    entries = []
    entry = None
    field = None
    for line in lines:
        m = ENTRY_RE.match(line)
        if m:
            entry = (m.group(1), {}, [])
            entries.append(entry)
            field = None
            continue
        if HEADING_RE.match(line):
            entry = None
            field = None
            continue
        if entry is None:
            continue
        m = FIELD_RE.match(line)
        if m:
            field = m.group(1)
            entry[2].append(field)
            entry[1][field] = line[m.end():].strip()
            continue
        if field is not None and line.startswith("  ") and line.strip():
            entry[1][field] += " " + line.strip()
        elif not line.strip():
            field = None
    return [(eid, fields, order) for eid, fields, order in entries]


def parse_inventory(lines):
    """(slug, entry) rows of the `## Test inventory` table, in file order, and
    whether the heading is present at all."""
    rows = []
    seen_heading = False
    inside = False
    for line in lines:
        if line.startswith("## "):
            inside = line.strip() == "## Test inventory"
            seen_heading = seen_heading or inside
            continue
        if not inside:
            continue
        m = ROW_RE.match(line)
        if m:
            rows.append((m.group(1), m.group(2)))
    return rows, seen_heading


def check_lessons(root, path):
    lines = (root / path).read_text(encoding="utf-8").splitlines()
    entries = parse_entries(lines)
    if not entries:
        fail(path, "no `###` entry — a lessons file with no entries is unread")
        return 0, 0

    named = {}
    for eid, fields, order in entries:
        for want in FIELDS:
            if want not in fields:
                fail(path, f"{eid} carries no **{want}:** field")
        for dup in {f for f in order if order.count(f) > 1 and f in FIELDS}:
            fail(path, f"{eid} carries **{dup}:** more than once")
        value = fields.get("Test")
        if value is None:
            continue
        m = SLUG_RE.search(value)
        if m:
            slug = m.group(1)
            if slug in named:
                fail(path, f"{eid} names lessons::{slug}, already named by {named[slug]}")
            else:
                named[slug] = eid
        elif not value.lstrip("`").startswith("none"):
            fail(path, f"{eid}'s **Test:** names no lessons:: slug and does not say none")

    rows, seen_heading = parse_inventory(lines)
    if not seen_heading:
        fail(path, "no `## Test inventory` section — the table the slices read is gone")
        return len(entries), 0

    listed = {}
    for slug, entry in rows:
        if slug in listed:
            fail(path, f"the inventory lists lessons::{slug} more than once")
            continue
        listed[slug] = entry

    for slug, eid in sorted(named.items()):
        if slug not in listed:
            fail(path, f"{eid} names lessons::{slug} and the inventory has no row for it")
        elif listed[slug] != eid:
            fail(
                path,
                f"the inventory's lessons::{slug} row names {listed[slug]}, "
                f"but the entry naming it is {eid}",
            )
    for slug, entry in sorted(listed.items()):
        if slug not in named:
            fail(path, f"the inventory lists lessons::{slug} and no entry names it")

    return len(entries), len(rows)


def roster(root):
    """The chosen names and seat directories of the rendered roster block. Read
    from the block rather than typed here, so a seat added upstream is a needle
    nobody has to remember to add."""
    text = (root / "seats/README.md").read_text(encoding="utf-8")
    block = re.search(r"<!-- roster:begin.*?-->(.*?)<!-- roster:end -->", text, re.S)
    if not block:
        sys.exit("lessons-check: seats/README.md carries no rendered roster block")
    needles = set()
    for line in block.group(1).splitlines():
        cells = [c.strip() for c in line.split("|")]
        if len(cells) < 3:
            continue
        name = re.search(r"\*\*([A-Za-z]+)\*\*", cells[1])
        seat = re.search(r"`([a-z0-9-]+)/`", cells[2])
        if name:
            needles.add(name.group(1))
        if seat:
            needles.add(seat.group(1))
    if not needles:
        sys.exit("lessons-check: the roster block yielded no names — the scan would prove nothing")
    return sorted(needles)


def check_boundary(root, lesson_paths, names):
    """No roster name or seat directory in the lessons documents."""
    word = {n: re.compile(rf"(?<![A-Za-z0-9]){re.escape(n)}(?![A-Za-z0-9])", re.I) for n in names}
    scanned = 0
    for path in sorted(lesson_paths):
        try:
            text = (root / path).read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        scanned += 1
        for n, line in enumerate(text.splitlines(), 1):
            for needle, pattern in word.items():
                if pattern.search(line):
                    fail(path, f"line {n} names the seat '{needle}'")
    # The control on the sweep above: a clean scan is only a reading if the
    # documents were opened at all, so a zero here is reported rather than read
    # as silence.
    if scanned != len(lesson_paths):
        fail(
            "boundary",
            f"{scanned} of {len(lesson_paths)} lesson file(s) were read — "
            "the rest could not be opened",
        )


def main():
    root = repo_root()
    lesson_paths = [p for p in tracked(root, "fleet/brain/lessons") if p.endswith(".md")]
    if not lesson_paths:
        sys.exit("lessons-check: no tracked file under fleet/brain/lessons — nothing to check")

    entries = tests = 0
    for path in lesson_paths:
        e, t = check_lessons(root, path)
        entries += e
        tests += t

    names = roster(root)
    check_boundary(root, set(lesson_paths), names)

    if failures:
        for line in failures:
            print(line)
        print(f"lessons-check: {len(failures)} finding(s)")
        return 1

    print(
        f"lessons-check: ok — {len(lesson_paths)} lesson file(s), {entries} entries, "
        f"{tests} inventory rows, {len(names)} roster needles, boundary clean"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
